# Proveedor del modelo: "anthropic" (real) o "simulado" (sin clave, guion determinista para pruebas de UI)
LLM_PROVIDER=anthropic
# Clave del proveedor. Solo vive en el backend; nunca se expone al front, logs ni respuestas.
ANTHROPIC_API_KEY=
# Modelo y esfuerzo de razonamiento
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# Timeout por llamada al proveedor (ms)
LLM_TIMEOUT_MS=90000
# Topes de costo
MAX_ITERACIONES=25
MAX_TOKENS_SESION=400000
MAX_CARACTERES_MENSAJE=2000
# Puerto HTTP
PORT=3006
# Opcional: si se define, el front pide esta clave de acceso y el backend la exige (header x-access-key)
ACCESS_KEY=
